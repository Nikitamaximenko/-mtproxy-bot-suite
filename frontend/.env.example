# BACKEND_URL=https://mtproxy-bot-suite-production.up.railway.app
BACKEND_URL=https://138-124-80-97.sslip.io:9443

# Тот же секрет, что INTERNAL_API_TOKEN на VPS (backend) и в bot/.env.
# Без него Mini App в Telegram всё равно работает через init_data (POST /api/vpn),
# но fallback-запросы и админ-прокси вернут internal_token_required / proxy_link: null.
# INTERNAL_API_TOKEN=
